{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rockwell-hackathon:evaluation-result:v1",
  "title": "Rockwell hackathon evaluation result v1",
  "description": "A versioned, machine-readable evaluation result. Missing measurements stay absent; evaluator-only truth must not be used as a runtime input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "created_at_utc",
    "split",
    "backend",
    "provenance",
    "vision",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "split": {
      "enum": ["pilot", "train", "validation", "test"]
    },
    "backend": {
      "enum": ["offline_replay", "isaac", "hardware"]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "vision": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/visionResult" }
      ]
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "sha256OrNull": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "integrationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "name", "version", "artifact_sha256"],
      "properties": {
        "component": {
          "enum": ["vision", "grasp", "task", "executor"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256OrNull"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_commit",
        "branch",
        "integration_profile",
        "object_catalog_version",
        "calibration_ids",
        "components",
        "source_run_ids"
      ],
      "properties": {
        "project_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "integration_profile": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/integrationProfile" }
          ]
        },
        "object_catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "calibration_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "source_run_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "poseSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_error_mm",
        "symmetry_aware_orientation_error_deg",
        "symmetry_id"
      ],
      "properties": {
        "position_error_mm": {
          "type": "number",
          "minimum": 0.0
        },
        "symmetry_aware_orientation_error_deg": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 180.0
            }
          ]
        },
        "symmetry_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classVisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "reference_instances",
        "true_positives",
        "false_positives",
        "dropouts",
        "pose_samples"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_instances": {
          "type": "integer",
          "minimum": 0
        },
        "true_positives": {
          "type": "integer",
          "minimum": 0
        },
        "false_positives": {
          "type": "integer",
          "minimum": 0
        },
        "dropouts": {
          "type": "integer",
          "minimum": 0
        },
        "pose_samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/poseSample"
          }
        }
      }
    },
    "visionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames_evaluated", "inference_latency_ms", "per_class"],
      "properties": {
        "frames_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "inference_latency_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0.0
          }
        },
        "per_class": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classVisionResult"
          }
        }
      }
    },
    "acceptedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "predicted_success_probability",
        "scorer_id",
        "model_version"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "predicted_success_probability": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          ]
        },
        "scorer_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model_version": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "reasons"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "graspAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_candidate_ids",
        "accepted_candidates",
        "rejected_candidates",
        "selected_candidate_id",
        "selected_candidate_outcome_observed",
        "selected_candidate_complete_grasp_success",
        "ranking_correct",
        "ranking_evidence_id"
      ],
      "properties": {
        "generated_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accepted_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptedCandidate"
          }
        },
        "rejected_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejectedCandidate"
          }
        },
        "selected_candidate_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "selected_candidate_outcome_observed": {
          "type": "boolean"
        },
        "selected_candidate_complete_grasp_success": {
          "type": ["boolean", "null"]
        },
        "ranking_correct": {
          "type": ["boolean", "null"]
        },
        "ranking_evidence_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "contact_count",
        "operator_intervention_count",
        "retry_count",
        "verification"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete_relocation_success",
            "failed_lift",
            "drop_or_slip",
            "wrong_destination",
            "cancelled",
            "unresolved",
            "not_executed"
          ]
        },
        "contact_count": {
          "type": "integer",
          "minimum": 0
        },
        "operator_intervention_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "verification": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["camera", "simulator_truth", "operator", "force_sensor"]
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perception_s": {
          "type": "number",
          "minimum": 0.0
        },
        "planning_s": {
          "type": "number",
          "minimum": 0.0
        },
        "execution_s": {
          "type": "number",
          "minimum": 0.0
        },
        "recovery_s": {
          "type": "number",
          "minimum": 0.0
        },
        "total_episode_s": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "condition_id",
        "scene_id",
        "target_track_id",
        "target_class_id",
        "grasp_attempt",
        "outcome",
        "timing_s"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "target_track_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "target_class_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "grasp_attempt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/graspAttempt" }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "timing_s": {
          "$ref": "#/$defs/timing"
        }
      }
    }
  }
}
