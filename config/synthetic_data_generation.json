{
  "schema_version": 1,
  "purpose": "Seeded, replayable synthetic-data capture for the colour-bucket sorting task. Broad exposure, colour-cast, vignetting, tabletop appearance, and destination display hues were fitted from compressed real table-camera rollouts; remaining ranges are conservative engineering starting values.",
  "capture": {
    "camera_name": "table",
    "resolution": [1920, 1080],
    "colour_space": "RGB",
    "image_encoding": "png",
    "save_raw_frames": true,
    "burn_in_overlay": false,
    "calibration_file": "hardware/fanuc_cell/calibration/cameras.json",
    "calibration_entry": "table",
    "apply_calibrated_radial_distortion": true,
    "maximum_state_skew_s": 0.016666666666666666
  },
  "range_status": {
    "name": "provisional_unmeasured",
    "warning": "The appearance profile is only a broad fit to compressed 640x360 hardware video. Orange/yellow/light-blue destination hue and saturation targets are display-RGB observations, not measured material albedos. Cube base colours still come from the starter asset and have not been fitted to masked real-cube samples. Native sensor noise, precise blur, camera response, small-object edges, materials, and physics remain unmeasured. Record sampled and actually applied values separately and validate on native held-out images before claiming sim-to-real accuracy."
  },
  "parameters": {
    "materials.coloured_plastic_roughness": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.22,
      "maximum": 0.38,
      "unit": "unitless",
      "nominal": 0.28
    },
    "materials.coloured_plastic_albedo_scale": {
      "consumer": "isaac_stage",
