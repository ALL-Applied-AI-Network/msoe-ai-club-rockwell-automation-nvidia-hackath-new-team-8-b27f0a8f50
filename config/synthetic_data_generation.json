{
  "schema_version": 1,
  "purpose": "Seeded, replayable synthetic-data capture for the colour-bucket sorting task. These are conservative engineering starting ranges, not measurements of the physical cell.",
  "capture": {
    "camera_name": "table",
    "resolution": [1920, 1080],
    "colour_space": "RGB",
    "image_encoding": "png",
    "save_raw_frames": true,
    "burn_in_overlay": false,
    "calibration_file": "hardware/fanuc_cell/calibration/cameras.json",
    "calibration_entry": "table",
    "apply_calibrated_radial_distortion": true,
    "maximum_state_skew_s": 0.016666666666666666
  },
  "range_status": {
    "name": "provisional_unmeasured",
    "warning": "Every enabled range must be replaced or bounded using physical measurements before claiming sim-to-real accuracy. Record sampled and actually applied values separately."
  },
  "parameters": {
    "materials.coloured_plastic_roughness": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.22,
      "maximum": 0.38,
      "unit": "unitless",
      "nominal": 0.28
    },
    "materials.coloured_plastic_albedo_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.85,
      "maximum": 1.15,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "materials.table_roughness": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.45,
      "maximum": 0.70,
      "unit": "unitless",
      "nominal": 0.55
    },
    "lighting.dome_intensity_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.75,
      "maximum": 1.25,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "lighting.key_intensity_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.70,
      "maximum": 1.30,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "lighting.fill_intensity_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.60,
      "maximum": 1.40,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "lighting.rim_intensity_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.50,
      "maximum": 1.50,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "lighting.source_size_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.75,
      "maximum": 1.25,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "camera.translation_x_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.001,
      "maximum": 0.001,
      "unit": "m",
      "nominal": 0.0
    },
    "camera.translation_y_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.001,
      "maximum": 0.001,
      "unit": "m",
      "nominal": 0.0
    },
    "camera.translation_z_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.001,
      "maximum": 0.001,
      "unit": "m",
      "nominal": 0.0
    },
    "camera.rotation_roll_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.15,
      "maximum": 0.15,
      "unit": "deg",
      "nominal": 0.0
    },
    "camera.rotation_pitch_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.15,
      "maximum": 0.15,
      "unit": "deg",
      "nominal": 0.0
    },
    "camera.rotation_yaw_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.15,
      "maximum": 0.15,
      "unit": "deg",
      "nominal": 0.0
    },
    "camera.focal_length_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.997,
      "maximum": 1.003,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "sensor.exposure_stops": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": -0.5,
      "maximum": 0.5,
      "unit": "stops",
      "nominal": 0.0
    },
    "sensor.white_balance_r": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.93,
      "maximum": 1.07,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "sensor.white_balance_g": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.97,
      "maximum": 1.03,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "sensor.white_balance_b": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.93,
      "maximum": 1.07,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "sensor.gamma": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.90,
      "maximum": 1.10,
      "unit": "unitless",
      "nominal": 1.0
    },
    "sensor.gaussian_noise_std_dn": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.0,
      "maximum": 2.5,
      "unit": "8_bit_digital_number",
      "nominal": 0.0
    },
    "sensor.gaussian_blur_sigma_px": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.0,
      "maximum": 1.0,
      "unit": "px",
      "nominal": 0.0
    },
    "sensor.vignette_strength": {
      "consumer": "sensor_postprocess",
      "distribution": "uniform",
      "minimum": 0.0,
      "maximum": 0.15,
      "unit": "unitless",
      "nominal": 0.0
    },
    "sensor.jpeg_quality": {
      "consumer": "sensor_postprocess",
      "distribution": "randint",
      "minimum": 92,
      "maximum": 100,
      "unit": "quality",
      "nominal": 100
    },
    "scene.red_cube_x_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.red_cube_y_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.red_cube_yaw_offset_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -45.0,
      "maximum": 45.0,
      "unit": "deg",
      "nominal": 0.0
    },
    "scene.yellow_cube_x_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.yellow_cube_y_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.yellow_cube_yaw_offset_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -45.0,
      "maximum": 45.0,
      "unit": "deg",
      "nominal": 0.0
    },
    "scene.blue_cube_x_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.blue_cube_y_offset_m": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -0.02,
      "maximum": 0.02,
      "unit": "m",
      "nominal": 0.0
    },
    "scene.blue_cube_yaw_offset_deg": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": -45.0,
      "maximum": 45.0,
      "unit": "deg",
      "nominal": 0.0
    },
    "physics.cube_mass_scale": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.90,
      "maximum": 1.10,
      "unit": "multiplier",
      "nominal": 1.0
    },
    "physics.object_static_friction": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.75,
      "maximum": 1.05,
      "unit": "unitless",
      "nominal": 0.90
    },
    "physics.object_dynamic_friction": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.65,
      "maximum": 0.95,
      "unit": "unitless",
      "nominal": 0.80
    },
    "physics.object_restitution": {
      "consumer": "isaac_stage",
      "distribution": "uniform",
      "minimum": 0.02,
      "maximum": 0.08,
      "unit": "unitless",
      "nominal": 0.05
    }
  }
}
